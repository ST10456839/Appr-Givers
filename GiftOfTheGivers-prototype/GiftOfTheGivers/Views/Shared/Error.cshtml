@model GiftOfTheGivers.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">An error occurred</h1>
@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> @Model.RequestId</p>
}
<p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a></p>
