@model DonationViewModel
@{
    ViewData["Title"] = "Donate";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="mb-2">Make a Donation</h1>
        <p class="text-muted mb-4">
            Every contribution helps us respond faster when disaster strikes. Amounts are symbolic
            at this prototype stage &mdash; no real payment is processed.
        </p>

        <form asp-controller="Donate" asp-action="Index" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="alert alert-info">
                    You're donating as a guest. <a asp-controller="Account" asp-action="Login">Login</a> or
                    <a asp-controller="Account" asp-action="Register">register</a> to keep a record of your donations,
                    or continue below to give anonymously.
                </div>
            }

            <div class="mb-3">
                <label asp-for="DonorName" class="form-label"></label>
                <input asp-for="DonorName" class="form-control" placeholder="e.g. Thandiwe Nkosi" />
                <span asp-validation-for="DonorName" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsAnonymous" class="form-check-input" />
                <label asp-for="IsAnonymous" class="form-check-label"></label>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Currency" class="form-label"></label>
                    <select asp-for="Currency" asp-items="Html.GetEnumSelectList<DonationCurrency>()" class="form-select"></select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label d-block">Donation Frequency</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsRecurring" id="oneTime" value="false" checked />
                    <label class="form-check-label" for="oneTime">One-time</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsRecurring" id="recurring" value="true" />
                    <label class="form-check-label" for="recurring">Recurring (monthly)</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Donate</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
