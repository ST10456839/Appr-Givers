@model Donation
@{
    ViewData["Title"] = "Thank You";
}

<div class="row justify-content-center">
    <div class="col-md-7 text-center">
        <h1 class="text-success mb-3">Thank You, @Model.DonorName!</h1>
        <p class="fs-5">
            Your @(Model.IsRecurring ? "recurring monthly" : "one-time") donation of
            <strong>@Model.Amount.ToString("0.00") @Model.Currency</strong> has been recorded.
        </p>
        <p class="text-muted">Certificate reference: @Model.CertificateNumber</p>

        <a asp-controller="Donate" asp-action="Certificate" asp-route-id="@Model.Id" class="btn btn-primary btn-lg mt-3">
            Download Placeholder Tax Certificate (PDF)
        </a>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-link">Back to Home</a>
        </div>
    </div>
</div>
